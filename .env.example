APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=de
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# --- Umstieg auf PostgreSQL + Redis (siehe docker-compose.yml) ---
# DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=5432
# DB_DATABASE=pixel
# DB_USERNAME=pixel
# DB_PASSWORD=<starkes-passwort>
# SESSION_DRIVER=redis
# CACHE_STORE=redis
# QUEUE_CONNECTION=redis

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ============================================================================
# ZAHLUNGEN (Pixel Chaos Shop)  -  alle Preise/Zugangsdaten stehen NUR hier
# Details & Links: config/payments.php
# Leere Werte = Anbieter ist deaktiviert und erscheint nicht im Shop.
# ============================================================================

# Preise in Cent (300 = 3,00 EUR)
PRICE_EXTEND_CENTS=300
PRICE_PIXELS_100_CENTS=500
PRICE_PIXELS_500_CENTS=1500

# --- Social Login (Google / Facebook) ----------------------------------------
# Google: console.cloud.google.com > APIs & Dienste > Anmeldedaten > OAuth-Client-ID (Webanwendung)
#   Weiterleitungs-URI: {APP_URL}/auth/google/callback
# Facebook: developers.facebook.com > App erstellen > Facebook Login > Gültige OAuth-Redirect-URI:
#   {APP_URL}/auth/facebook/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# --- RECHTLICHES (Impressum/Datenschutz, siehe config/legal.php) -------------
# Pflichtangaben vor dem Livegang ausfuellen. Leere Werte erscheinen als gelber Platzhalter.
LEGAL_NAME=
LEGAL_STREET=
LEGAL_ZIP_CITY=
LEGAL_COUNTRY=Deutschland
LEGAL_EMAIL=
LEGAL_PHONE=
LEGAL_VAT_ID=
LEGAL_REGISTER=
LEGAL_RESPONSIBLE=
LEGAL_HOSTING=

# --- PayPal (sandbox | live) -------------------------------------------------
# developer.paypal.com > Apps & Credentials > Sandbox > App erstellen
PAYPAL_MODE=sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# --- Stripe: Karte, Apple/Google Pay, SEPA, Klarna ... -----------------------
# dashboard.stripe.com/test/apikeys  (sk_test_... = Sandbox, sk_live_... = echt)
STRIPE_SECRET_KEY=
# Nur noetig fuer asynchrone Zahlungen (SEPA): Webhook-URL = APP_URL/webhooks/stripe
STRIPE_WEBHOOK_SECRET=

# --- Mollie: iDEAL, Karte, PayPal, SEPA, Klarna ... --------------------------
# my.mollie.com > Developers > API-Keys  (test_... = Sandbox, live_... = echt)
MOLLIE_API_KEY=

# --- Lokale Test-Zahlung ohne Konto (wird in APP_ENV=production ignoriert) ---
PAYMENTS_FAKE_ENABLED=true
